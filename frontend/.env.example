# ========================================
# 🏥 APPOINTCARE FRONTEND - ENVIRONMENT
# ========================================

# ==========================================
# API CONFIGURATION
# ==========================================
REACT_APP_API_URL=http://localhost:3000

# ==========================================
# GOOGLE reCAPTCHA v2 SITE KEY
# ==========================================
# Get this from: https://www.google.com/recaptcha/admin
# This is the PUBLIC key (safe to expose)
REACT_APP_RECAPTCHA_SITE_KEY=your_recaptcha_site_key_here

# Note: Site Key is public and safe to share in frontend code
# Secret Key should NEVER be exposed in frontend
